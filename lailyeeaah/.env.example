# Salin nilai-nilai ini ke Environment Variables di Vercel (Settings → Environment Variables)
# JANGAN commit file .env berisi nilai asli ke GitHub.

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...   # service_role key (rahasia, hanya untuk server)

# Fonnte (dashboard Fonnte setelah scan QR)
FONNTE_TOKEN=isi_token_fonnte

# Nomor WA admin penerima notifikasi, format 628xxxxxxxxxx
ADMIN_WA_NUMBER=6281234567890

# Password login admin web
ADMIN_PASSWORD=gantipasswordini

# Secret untuk melindungi endpoint /api/check-expired (bebas, string acak)
CRON_SECRET=gantisecretacak123
