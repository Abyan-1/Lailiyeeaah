# Isi semua nilai ini di Vercel → Settings → Environment Variables, lalu REDEPLOY.
# Jangan pernah commit file .env berisi nilai asli.

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=isi_service_role_key

# Fonnte — token milik DEVICE (dashboard Fonnte → Device → Token), device harus CONNECTED
FONNTE_TOKEN=isi_token_device_fonnte

# Nomor WA ADMIN penerima notif: angka saja, diawali 62 (bukan 08 / +62)
ADMIN_WA_NUMBER=6281234567890

# Password login web admin
ADMIN_PASSWORD=gantipasswordini

# Secret untuk /api/check-expired dan /api/test-wa (string acak bebas)
CRON_SECRET=gantisecretacak123

# Opsional: kirim peringatan "hampir habis" berapa menit sebelum habis (default 10)
# Contoh 1440 = 24 jam sebelum habis
PERINGATAN_MENIT=10
