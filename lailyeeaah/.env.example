# Isi semua nilai ini di Vercel → Settings → Environment Variables, lalu REDEPLOY.
# Jangan pernah commit file .env berisi nilai asli.

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=isi_service_role_key

# Web Push Notification (VAPID)
# Buat pasangan kunci dengan menjalankan di terminal:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=isi_vapid_public_key
VAPID_PRIVATE_KEY=isi_vapid_private_key
VAPID_SUBJECT=mailto:admin@example.com

# Password login web admin
ADMIN_PASSWORD=gantipasswordini

# Secret untuk /api/check-expired dan /api/test-push (string acak bebas)
CRON_SECRET=gantisecretacak123

# Opsional: kirim peringatan "hampir habis" berapa menit sebelum habis (default 10)
# Contoh 1440 = 24 jam sebelum habis
PERINGATAN_MENIT=10
